  function toggle(open) {\n    panel.classList.toggle(\"open\", open);\n    hint.style.display = \"none\";\n    if (open) {\n      if (!greeted) { add(\"\u00a1Hola! Soy Sofi, de V\u00e9rtice Athletics \ud83d\udc5f \u00bfEn qu\u00e9 te ayudo hoy?\", \"bot\"); greeted = true; }\n      setTimeout(function () { input.focus(); }, 150);\n    }\n  }\n\n  $(\".fab\").onclick = function () { toggle(!panel.classList.contains(\"open\")); };\n  hint.onclick = function () { toggle(true); };\n  $(\".x\").onclick = function () { toggle(false); };\n\n  async function guardarAviso(a) {\n    var db = await dbP, user = await userP;\n    if (!db || !user) throw new Error(\"sin almacenamiento\");\n    var id = await user.id();\n    var ref = db.doc(\"alertas/\" + id);\n    var snap = await ref.get();\n    var lista = (snap.exists && snap.data().lista) || [];\n    lista.push(Object.assign({ fecha: new Date().toISOString() }, a));\n    await ref.set({ lista: lista.slice(-30), ultima: new Date().toISOString() });\n  }\n\n  var TOOLS = [\n    { name: \"consultar_pedido\",\n      description: \"Consulta el estado de un pedido de V\u00e9rtice Athletics por su n\u00famero (formato VA-12345). Devuelve el estado o encontrado:false.\",\n      inputSchema: { type: \"object\", properties: { numero_pedido: { type: \"string\" } }, required: [\"numero_pedido\"] },\n      execute: function (inp) {\n        var id = String(inp.numero_pedido || \"\").toUpperCase().replace(/\\s+/g, \"\").replace(/^VA(?=\\d)/, \"VA-\");\n        var p = PEDIDOS[id];\n        return p ? Object.assign({ encontrado: true, numero: id }, p) : { encontrado: false, numero: id };\n      } },\n    { name: \"avisar_al_equipo\",\n      description: \"Avisa al due\u00f1o/equipo humano cuando el cliente est\u00e1 molesto o pide hablar con una persona. Devuelve si el aviso qued\u00f3 registrado.\",\n      inputSchema: { type: \"object\", properties: {\n        motivo: { type: \"string\", enum: [\"cliente_molesto\", \"pide_persona\", \"ambos\"] },\n        resumen: { type: \"string\" }, contacto: { type: \"string\" }, numero_pedido: { type: \"string\" } },\n        required: [\"motivo\", \"resumen\"] },\n      execute: async function (inp) {\n        try {\n          await guardarAviso({ motivo: String(inp.motivo || \"\"), resumen: String(inp.resumen || \"\").slice(0, 600),\n            contacto: inp.contacto ? String(inp.contacto).slice(0, 120) : \"\", numero_pedido: inp.numero_pedido ? String(inp.numero_pedido) : \"\" });\n          return \"Aviso registrado: el equipo lo ver\u00e1.\";\n        } catch (e) {\n          throw new Error(\"No se pudo registrar el aviso autom\u00e1ticamente. Pide al cliente que escriba al equipo desde la secci\u00f3n Contacto de la p\u00e1gina, y no digas que ya avisaste.\");\n        }\n      } }\n  ];\n\n  function limpiar(t) { return String(t || \"\").replace(/\\*\\*(.+?)\\*\\*/g, \"$1\").replace(/__(.+?)__/g, \"$1\"); }\n\n  async function ask(text) {\n    if (busy || !text.trim()) return;\n    busy = true; send.disabled = true; chips.style.display = \"none\";\n    add(text, \"me\");\n    input.value = \"\";\n    var t = add(\"\", \"bot\");\n    t.innerHTML = '<span class=\"typing\"><i><\/i><i><\/i><i><\/i><\/span>';\n    turns.push({ role: \"user\", content: text });\n    while (turns.length > 16) turns.shift();\n    if (turns[0].role !== \"user\") turns.shift();\n    var sample = await sampleP;\n    if (!sample) {\n      t.textContent = \"Para chatear con Sofi abre esta p\u00e1gina con tu cuenta de Claude \ud83d\ude4f\";\n      turns.pop(); busy = false; send.disabled = false; return;\n    }\n    try {\n      var r = await sample([{ role: \"user\", content: RULES }].concat(turns), {\n        tools: TOOLS, modelTier: \"quick\",\n        onText: function (u) { t.textContent = limpiar(u.text.split(/\\n\\n/).pop()); msgs.scrollTop = msgs.scrollHeight; }\n      });\n      var final = limpiar(r.text.trim().split(/\\n\\s*\\n/).filter(Boolean).slice(-2).join(\"\\n\\n\"));\n      t.textContent = final;\n      turns.push({ role: \"assistant\", content: final });\n      refrescarAvisos();\n    } catch (e) {\n      turns.pop();\n      var c = e && e.code;\n      t.textContent = c === \"not_granted\" || c === \"sampling_disabled\" ? \"Necesito tu permiso para usar Claude y poder responderte. Recarga la p\u00e1gina y acepta el aviso \ud83d\ude4f\"\n        : c === \"rate_limited\" ? \"Estoy recibiendo muchos mensajes. Espera un momento y vuelve a intentarlo \ud83d\ude4f\"\n        : c === \"tools_unavailable\" ? \"Esta app de Claude no permite consultar pedidos aqu\u00ed. Prueba desde claude.ai en el navegador.\"\n        : \"Uy, tuve un problemita para responder \ud83d\ude05. \u00bfMe lo repites?\";\n    }\n    msgs.scrollTop = msgs.scrollHeight;\n    busy = false; send.disabled = false; input.focus();\n  }\n\n  // Panel de avisos: solo lo ve la due\u00f1a de la p\u00e1gina.\n  var bell = $(\".bell\"), alertsBox = $(\".alerts\"), alist = $(\".alist\");\n  async function refrescarAvisos() {\n    var user = await userP, db = await dbP;\n    if (!user || !db || !(await user.isOwner())) return;\n    bell.hidden = false;\n    try {\n      var res = await db.collection(\"alertas\").get();\n      var todos = [];\n      (res.docs || res).forEach(function (d) { var x = d.data ? d.data() : d; (x.lista || []).forEach(function (a) { todos.push(a); }); });\n      todos.sort(function (a, b) { return a.fecha < b.fecha ? 1 : -1; });\n      bell.textContent = \"\ud83d\udd14 Avisos\" + (todos.length ? \" (\" + todos.length + \")\" : \"\");\n      alist.innerHTML = \"\";\n      if (!todos.length) alist.textContent = \"Sin avisos todav\u00eda.\";\n      todos.forEach(function (a) {\n        var d = document.createElement(\"div\"); d.className = \"al\";\n        var s = document.createElement(\"small\");\n        s.textContent = new Date(a.fecha).toLocaleString() + \" \u00b7 \" + (a.motivo || \"\").replace(\"_\", \" \") + (a.numero_pedido ? \" \u00b7 \" + a.numero_pedido : \"\");\n        var p = document.createElement(\"div\"); p.textContent = a.resumen + (a.contacto ? \" \u2014 Contacto: \" + a.contacto : \"\");\n        d.appendChild(s); d.appendChild(p); alist.appendChild(d);\n      });\n    } catch (e) {}\n  }\n  bell.onclick = function () { alertsBox.classList.toggle(\"open\"); refrescarAvisos(); };\n  refrescarAvisos();\n\n  form.onsubmit = function (e) { e.preventDefault(); ask(input.value); };\n  root.querySelectorAll(\".chip\").forEach(function (c) { c.onclick = function () { ask(c.textContent); }; });\n})();\n<\/script><\/body><\/html>"</script>
